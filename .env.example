# APIx System Environment Configuration (Example)
# Copy to .env for local deployment. NEVER commit actual production secrets.

# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg2://apix_user:apix_password@localhost:5432/apix

# Web Scraping & Playwright Parameters
PLAYWRIGHT_HEADLESS=true
SCRAPE_RATE_SECONDS=7
SCRAPE_TIMEOUT_SECONDS=45
DEFAULT_ORIGIN=DEL
DEFAULT_DESTINATION=BOM
DEFAULT_DEPARTURE_DATE=2026-09-15

# Security & Network
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=production
API_PORT=5000
API_HOST=0.0.0.0
